RewriteEngine On
RewriteBase /

# Remove InfinityFree tracking parameter
RewriteCond %{QUERY_STRING} ^i=[0-9]+$ [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

# Prevent directory listing
Options -Indexes

# Serve static assets from public/ directory
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(css|js|images)/(.*)$ public/$1/$2 [L]

# Prevent access to sensitive directories
RewriteRule ^(config|core|models|middleware|database)/ - [F,L]

# Prevent access to install.php after installation
RewriteRule ^install\.php$ - [F,L]

# API routes
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ api/$1 [L,QSA]

# Admin routes
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/(.*)$ index.php?route=admin/$1 [L,QSA]

# Client routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
